# CloudFront + on-demand WebP variants for the media bucket (lb-28).
#
# THE PROBLEM, measured on production 2026-10-24: 35 product images averaging
# 1.9 MB, stored as PNG, served straight from S3 in us-west-2 with NO
# Cache-Control header and no CDN. A 10-item browse feed was ~19 MB,
# re-downloaded on every scroll, from one region regardless of where the buyer
# was. A 400w WebP of the largest of them is 14 KB - 179x smaller.
#
# ONE ORIGIN. CloudFront serves the bucket; variants are generated by an S3
# TRIGGER on upload, not on request.
#
# The request-time design was tried first and abandoned: it needed a Lambda
# Function URL as a second origin, and a public Function URL returns 403 in
# this account regardless of how its resource policy is written - the function
# is never invoked at all (zero log streams), so the denial sits above Lambda.
# Switching it to AWS_IAM with a CloudFront OAC did not fix it either.
#
# An S3 ObjectCreated trigger invokes Lambda directly, which is the
# well-trodden path and has none of that auth surface. The cost is that
# existing objects need a one-off backfill (35 images) and a new width needs a
# re-run - both cheap at this scale, and neither is worth more hours of
# debugging CloudFront-to-Lambda signing.
#
# The bucket keeps its public-read policy (see backend-service/s3.tf) rather
# than being locked behind OAC. That is deliberate for now: the 35 live
# image_url values in the database are absolute S3 URLs, so cutting off direct
# S3 access would break every existing listing. Switching to OAC is a
# follow-up once those rows are rewritten to the CDN host.

locals {
  name = "lytebuy-media-${var.env}"

  s3_origin_id = "media-s3"
}

data "aws_route53_zone" "root" {
  name         = "${var.root_domain}."
  private_zone = false
}

# CloudFront requires its certificate in us-east-1, whatever region the origin
# is in. The wildcard already covers media.lytebuy.com.
data "aws_acm_certificate" "wildcard_us_east_1" {
  provider    = aws.us_east_1
  domain      = var.root_domain
  statuses    = ["ISSUED"]
  most_recent = true
}

# --- the resize function ----------------------------------------------------

data "aws_iam_policy_document" "resize_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "resize" {
  name               = "${local.name}-resize"
  assume_role_policy = data.aws_iam_policy_document.resize_assume.json
}

# READ the originals, WRITE only the variants.
#
# The write is scoped to `*w.webp` so a compromised function cannot overwrite a
# vendor's original upload - that file is their only copy, and the resizer has
# no business replacing it. Note `downloads/*` is NOT excluded here by path
# because the function itself refuses those keys (resize.js); this policy is
# the second layer, bounding what a bug could reach.
data "aws_iam_policy_document" "resize" {
  statement {
    sid       = "ReadOriginals"
    actions   = ["s3:GetObject"]
    resources = ["arn:aws:s3:::${var.media_bucket}/*"]
  }
  statement {
    sid       = "WriteVariantsOnly"
    actions   = ["s3:PutObject"]
    resources = ["arn:aws:s3:::${var.media_bucket}/*w.webp"]
  }
}

resource "aws_iam_role_policy" "resize" {
  name   = "media-access"
  role   = aws_iam_role.resize.id
  policy = data.aws_iam_policy_document.resize.json
}

resource "aws_iam_role_policy_attachment" "resize_logs" {
  role       = aws_iam_role.resize.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_cloudwatch_log_group" "resize" {
  name              = "/aws/lambda/${local.name}-resize"
  retention_in_days = 7
}

resource "aws_lambda_function" "resize" {
  function_name = "${local.name}-resize"
  role          = aws_iam_role.resize.arn
  handler       = "index.handler"
  runtime       = "nodejs22.x"

  # Graviton: cheaper per ms, and what the build script compiles sharp for.
  architectures = ["arm64"]

  filename         = var.resize_zip_path
  source_code_hash = filebase64sha256(var.resize_zip_path)

  # 1536MB is not for the image - a 2.5MB PNG decodes in well under that. It is
  # for SPEED: Lambda scales CPU with memory, and a resize is CPU-bound, so the
  # larger size finishes faster and often costs LESS for the same work.
  memory_size = 1536
  timeout     = 30

  environment {
    variables = {
      MEDIA_BUCKET   = var.media_bucket
      RESIZE_WIDTHS  = join(",", var.resize_widths)
      RESIZE_QUALITY = tostring(var.resize_quality)
    }
  }

  depends_on = [aws_cloudwatch_log_group.resize]
}

# A Function URL rather than API Gateway: there is nothing for a gateway to add
# here (no auth, no routing, no request mapping) and it would be another hop to
# pay for and another thing to misconfigure.
# --- the S3 trigger --------------------------------------------------------

# Fire on upload, scoped to the prefixes that hold displayable images.
#
# SCOPED BY PREFIX, not bucket-wide. `vendors/*/downloads/*` is the paywall for
# digital goods (app/services/digital_assets.py) and must never be read by
# this function, and a 500MB STL would be a guaranteed timeout. S3 filters
# support ONE prefix and ONE suffix per rule, so each (prefix, suffix) pair is
# its own rule - hence the nested loop below rather than a single filter.
locals {
  # The displayable-image prefixes. Mirrors the public-read prefixes in
  # backend-service/s3.tf, minus users/ which holds avatars that are already
  # small, and minus downloads/ which is private on purpose.
  trigger_prefixes = [
    "vendors/",
    "users/",
  ]
  trigger_suffixes = [".png", ".jpg", ".jpeg", ".webp", ".PNG", ".JPG", ".JPEG"]

  trigger_rules = flatten([
    for prefix in local.trigger_prefixes : [
      for suffix in local.trigger_suffixes : {
        key    = "${prefix}${suffix}"
        prefix = prefix
        suffix = suffix
      }
    ]
  ])
}

resource "aws_lambda_permission" "resize_from_s3" {
  statement_id  = "AllowS3Invoke"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.resize.function_name
  principal     = "s3.amazonaws.com"
  source_arn    = "arn:aws:s3:::${var.media_bucket}"
}

resource "aws_s3_bucket_notification" "media_resize" {
  bucket = var.media_bucket

  dynamic "lambda_function" {
    for_each = { for rule in local.trigger_rules : rule.key => rule }
    content {
      lambda_function_arn = aws_lambda_function.resize.arn
      events              = ["s3:ObjectCreated:*"]
      filter_prefix       = lambda_function.value.prefix
      filter_suffix       = lambda_function.value.suffix
    }
  }

  # The permission must exist before S3 will accept a notification pointing at
  # the function, or the apply fails with "Unable to validate the following
  # destination configurations".
  depends_on = [aws_lambda_permission.resize_from_s3]
}

# --- CloudFront -------------------------------------------------------------

resource "aws_cloudfront_distribution" "media" {
  enabled         = true
  is_ipv6_enabled = true
  comment         = local.name
  aliases         = [var.media_hostname]
  price_class     = "PriceClass_100" # NA + EU. lytebuy is US-only.

  origin {
    domain_name = "${var.media_bucket}.s3.${var.media_bucket_region}.amazonaws.com"
    origin_id   = local.s3_origin_id

    # The bucket serves these prefixes publicly, so this is a plain custom
    # origin rather than OAC. See the note at the top of this file.
    custom_origin_config {
      http_port              = 80
      https_port             = 443
      origin_protocol_policy = "https-only"
      origin_ssl_protocols   = ["TLSv1.2"]
    }
  }

  # Anything that is not a known variant pattern: straight to S3.
  default_cache_behavior {
    target_origin_id       = local.s3_origin_id
    viewer_protocol_policy = "redirect-to-https"
    allowed_methods        = ["GET", "HEAD", "OPTIONS"]
    cached_methods         = ["GET", "HEAD"]
    compress               = true
    cache_policy_id        = "658327ea-f89d-4fab-a63d-7e88639e58f6" # managed CachingOptimized
  }

  restrictions {
    geo_restriction {
      restriction_type = "none"
    }
  }

  viewer_certificate {
    acm_certificate_arn      = data.aws_acm_certificate.wildcard_us_east_1.arn
    ssl_support_method       = "sni-only"
    minimum_protocol_version = "TLSv1.2_2021"
  }
}

resource "aws_route53_record" "media" {
  for_each = toset(["A", "AAAA"])

  zone_id = data.aws_route53_zone.root.zone_id
  name    = var.media_hostname
  type    = each.key

  alias {
    name                   = aws_cloudfront_distribution.media.domain_name
    zone_id                = aws_cloudfront_distribution.media.hosted_zone_id
    evaluate_target_health = false
  }
}
