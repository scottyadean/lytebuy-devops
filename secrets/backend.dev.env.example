# Backend secrets for the DEV (beta) environment.
#
#   cp secrets/backend.dev.env.example secrets/backend.dev.env
#   # fill in real values, then:
#   scripts/put-secrets.sh dev
#
# secrets/backend.dev.env is GITIGNORED - never commit it. These land in SSM
# Parameter Store as SecureStrings under /lytebuy/dev/backend/<NAME> and are
# injected into the ECS task at launch. Only the values below are secrets; the
# non-secret config (APP_ENV, REDIS_URL loopback, bucket/region, CORS, etc.) is
# set in the task definition by tofu, not here.
#
# The NAMES here must match `secret_names` in modules/backend-service/variables.tf.

# --- Security ---------------------------------------------------------------
# Fresh strong value: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_min_32_chars_random

# --- Database (compose from the tofu `rds_endpoint` output) -----------------
# After `deploy.sh dev`, run `tofu output rds_endpoint` in environments/dev and
# substitute it for HOST below. USER/DB default to lytebuy; PASS is the value you
# passed as TF_VAR_db_bootstrap_password when creating RDS.
DATABASE_URL=postgresql+asyncpg://lytebuy:PASS@HOST:5432/lytebuy
ALEMBIC_DATABASE_URL=postgresql+psycopg://lytebuy:PASS@HOST:5432/lytebuy

# --- Bootstrap admin --------------------------------------------------------
FIRST_SUPERUSER_EMAIL=admin@lytebuy.com
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_strong_unique

# --- Stripe (TEST keys for the beta; swap to live later - see README) -------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Fill AFTER you register the webhook endpoint at https://dev-api.lytebuy.com.
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# --- Geocoding (use the ROTATED key, not the leaked one) --------------------
MAPQUEST_API_KEY=your_rotated_key

# --- Media S3 credentials ---------------------------------------------------
# The bucket/region are non-secret (set by tofu). These are the IAM keys the app
# uses to sign presigned URLs. (If you later give the task role direct S3 access
# and drop static keys, remove these two from secret_names too.)
MEDIA_STORAGE_ACCESS_KEY=CHANGE_ME
MEDIA_STORAGE_SECRET_KEY=CHANGE_ME

# --- Error monitoring (optional; empty disables Sentry) ---------------------
SENTRY_DSN=

GOOGLE_PLACE_API_KEY=xxxxxxxxxxxxxx